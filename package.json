{
  "name": "graphclaw-cockpit",
  "private": true,
  "version": "0.1.2",
  "description": "GraphClaw Cockpit — React 19 + TypeScript SPA for the GraphClaw task graph management system",
  "license": "Apache-2.0",
  "author": "GraphClaw Contributors",
  "homepage": "https://graphclaw.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graphclaw/graphclaw-cockpit.git"
  },
  "bugs": {
    "url": "https://github.com/graphclaw/graphclaw-cockpit/issues"
  },
  "keywords": [
    "graphclaw",
    "task-management",
    "graph",
    "ai-agents",
    "react",
    "typescript"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "regen-inventory": "node scripts/regen-inventory.mjs",
    "check-headers": "node scripts/check-test-headers.mjs",
    "test:coverage": "vitest run --coverage",
    "seed": "npx tsx e2e/seed/seed-all.ts",
    "teardown": "npx tsx e2e/seed/teardown-all.ts",
    "sync-openapi": "curl -sf http://localhost:8010/openapi.json -o src/test/openapi.json && echo 'openapi.json updated'",
    "gen:api": "openapi-typescript src/test/openapi.json -o src/lib/api-types.ts",
    "test:contract": "vitest run src/test/contract/"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@hookform/resolvers": "^5.7.1",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toggle": "^1.1.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cytoscape": "^3.33.2",
    "cytoscape-dagre": "^4.0.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.31.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/cytoscape": "^3.31.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "msw": "^2.13.3",
    "openapi-typescript": "^7.10.1",
    "pg": "^8.23.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
